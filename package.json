{
  "name": "studio-keputusan",
  "productName": "Studio Keputusan",
  "version": "1.2.0",
  "description": "Studio analisis strategis & keputusan lintas rumpun ilmu: 15 metode (Delphi, ISM–MICMAC, AHP, SWOT, PESTEL, Porter, CBA, CPM/PERT, BSC, SNA, analisis kualitatif, Space Syntax, Site Analysis, Behavioral Mapping, POE)",
  "author": "Pindo Tutuko",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "id.ac.unmer.studiokeputusan",
    "productName": "Studio Keputusan",
    "copyright": "Pindo Tutuko",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Studio Keputusan"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Education"
    }
  }
}